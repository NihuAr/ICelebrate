<Page x:Class="Kursachzhoska.Pages.MyEventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursachzhoska.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1140"
      Background="{StaticResource BackgroundColor}">

    <Grid Margin="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Мои мероприятия"
                       Style="{StaticResource H1}"
                       VerticalAlignment="Center"
                       Margin="0,0,32,0"/>

            <!-- Поиск -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    MaxWidth="400"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Placeholder -->
                    <TextBlock Grid.Column="0"
                               x:Name="SearchPlaceholder"
                               Text="Найти..."
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryColor}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <TextBox Grid.Column="0"
                             x:Name="SearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             FontFamily="{StaticResource PrimaryFont}"
                             FontSize="14"
                             Foreground="{StaticResource TextPrimaryColor}"
                             TextChanged="SearchBox_TextChanged"
                             GotFocus="SearchBox_GotFocus"
                             LostFocus="SearchBox_LostFocus"/>

                    <Path Grid.Column="1"
                          Data="{StaticResource SearchIcon}"
                          Fill="{StaticResource TextSecondaryColor}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Дата -->
            <TextBlock Grid.Column="2"
                       Text="October"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryColor}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- Вкладки Future/Past -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,24">
            <Button x:Name="FutureButton"
                    Content="Будущие"
                    Style="{StaticResource DarkButton}"
                    Padding="24,10"
                    FontSize="13"
                    Margin="0,0,8,0"
                    Click="FutureButton_Click"/>

            <Button x:Name="PastButton"
                    Content="Прошедшие"
                    Style="{StaticResource LightButton}"
                    Padding="24,10"
                    FontSize="13"
                    Click="PastButton_Click"/>
        </StackPanel>

        <!-- Сетка событий -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="EventsPanel" Orientation="Horizontal">
                <!-- События будут добавлены программно -->
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Page>
