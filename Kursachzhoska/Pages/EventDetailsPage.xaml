<Page x:Class="Kursachzhoska.Pages.EventDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursachzhoska.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1140"
      Background="{StaticResource BackgroundColor}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="48,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Back Button -->
            <Button Grid.Row="0"
                    Style="{StaticResource LightButton}"
                    HorizontalAlignment="Left"
                    Padding="12,10"
                    Margin="0,0,0,24"
                    Click="BackButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource ArrowBackIcon}" Fill="{StaticResource TextPrimaryColor}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Назад" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Content -->
            <Grid Grid.Row="1" MaxWidth="800" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Event Image -->
                <Border Grid.Row="0"
                        x:Name="EventImageBorder"
                        Height="400"
                        CornerRadius="12"
                        Margin="0,0,0,24">
                    <Grid>
                        <Border x:Name="EventImageContainer"
                                Background="#6366F1"
                                CornerRadius="12">
                            <Image x:Name="EventImage"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed"/>
                        </Border>
                        
                        <!-- Favorite Button -->
                        <Button x:Name="FavoriteButton"
                                Style="{StaticResource IconButton}"
                                Width="48"
                                Height="48"
                                Background="{StaticResource SurfaceColor}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,16,16,0"
                                Click="FavoriteButton_Click">
                            <Path x:Name="FavoriteIcon" Data="{StaticResource FavoriteBorderIcon}" Fill="#EF4444" Width="24" Height="24" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Event Details -->
                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        Padding="32">
                    <StackPanel>
                        <!-- Category -->
                        <TextBlock x:Name="CategoryText"
                                   Text="Category"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   Margin="0,0,0,8"/>

                        <!-- Title -->
                        <TextBlock x:Name="TitleText"
                                   Text="Название мероприятия"
                                   Style="{StaticResource H1}"
                                   Margin="0,0,0,24"/>

                        <!-- Date, Location, Price -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="{StaticResource CalendarIcon}" Fill="{StaticResource TextSecondaryColor}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Дата и время"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="DateTimeText"
                                           Text="01.01.2024 18:00"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryColor}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="{StaticResource LocationIcon}" Fill="{StaticResource TextSecondaryColor}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Место"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="LocationText"
                                           Text="Location"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryColor}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="{StaticResource TicketIcon}" Fill="{StaticResource TextSecondaryColor}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Цена"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="PriceText"
                                           Text="0₽"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryColor}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Organizer Info -->
                        <Border Background="{StaticResource SurfaceColor}"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,24">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Path Data="{StaticResource PersonIcon}" Fill="{StaticResource TextSecondaryColor}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Организатор"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryColor}"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="OrganizerNameText"
                                           Text="Название организатора"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryColor}"
                                           Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OrganizerRatingStars"
                                               Text="★★★★★"
                                               FontSize="14"
                                               Foreground="{StaticResource AccentColor}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock x:Name="OrganizerRatingText"
                                               Text="5.0 (10 reviews)"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Description -->
                        <TextBlock Text="Описание"
                                   Style="{StaticResource H3}"
                                   Margin="0,0,0,12"/>
                        <TextBlock x:Name="DescriptionText"
                                   Text="Описание мероприятия..."
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24"/>

                        <!-- Contractors -->
                        <TextBlock x:Name="ContractorsTitle"
                                   Text="Подрядчики"
                                   Style="{StaticResource H3}"
                                   Margin="0,0,0,12"
                                   Visibility="Collapsed"/>
                        <StackPanel x:Name="ContractorsPanel"
                                    Margin="0,0,0,24">
                            <!-- Contractors will be added programmatically -->
                        </StackPanel>

                        <!-- Documents -->
                        <TextBlock x:Name="DocumentsTitle"
                                   Text="Документы"
                                   Style="{StaticResource H3}"
                                   Margin="0,0,0,12"
                                   Visibility="Collapsed"/>
                        <StackPanel x:Name="DocumentsPanel"
                                    Margin="0,0,0,24">
                            <!-- Documents will be added programmatically -->
                        </StackPanel>

                        <!-- Reviews -->
                        <TextBlock x:Name="ReviewsTitle"
                                   Text="Отзывы"
                                   Style="{StaticResource H3}"
                                   Margin="0,0,0,12"
                                   Visibility="Collapsed"/>
                        <StackPanel x:Name="ReviewsPanel"
                                    Margin="0,0,0,24">
                            <!-- Reviews will be added programmatically -->
                        </StackPanel>

                        <!-- Register Button -->
                        <Button x:Name="RegisterButton"
                                Content="Зарегистрироваться"
                                Style="{StaticResource DarkButton}"
                                Padding="32,14"
                                HorizontalAlignment="Center"
                                Click="RegisterButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

