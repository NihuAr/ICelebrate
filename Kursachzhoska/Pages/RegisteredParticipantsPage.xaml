<Page x:Class="Kursachzhoska.Pages.RegisteredParticipantsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursachzhoska.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1140"
      Background="{StaticResource BackgroundColor}">

    <Grid Margin="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Зарегистрированные участники"
                       Style="{StaticResource H1}"
                       VerticalAlignment="Center"
                       Margin="0,0,32,0"/>

            <!-- Поиск -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceColor}"
                    CornerRadius="8"
                    Padding="12,8"
                    MaxWidth="400"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Data="{StaticResource SearchIcon}"
                          Fill="{StaticResource TextSecondaryColor}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             x:Name="SearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             FontFamily="{StaticResource PrimaryFont}"
                             FontSize="14"
                             Tag="Найти..."/>
                </Grid>
            </Border>

            <!-- Дата -->
            <TextBlock Grid.Column="2"
                       Text="October"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryColor}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- Список участников -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ParticipantsPanel">
                <!-- Участники будут добавлены программно -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

