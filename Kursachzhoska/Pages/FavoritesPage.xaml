<Page x:Class="Kursachzhoska.Pages.FavoritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursachzhoska.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1140"
      Background="{StaticResource BackgroundColor}">

    <Grid Margin="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и поиск -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Избранное"
                       Style="{StaticResource H1}"
                       VerticalAlignment="Center"
                       Margin="0,0,32,0"/>

            <!-- Поиск -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    MaxWidth="400"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Placeholder -->
                    <TextBlock Grid.Column="0"
                               x:Name="SearchPlaceholder"
                               Text="Найти..."
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryColor}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <TextBox Grid.Column="0"
                             x:Name="SearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             FontFamily="{StaticResource PrimaryFont}"
                             FontSize="14"
                             Foreground="{StaticResource TextPrimaryColor}"
                             TextChanged="SearchBox_TextChanged"
                             GotFocus="SearchBox_GotFocus"
                             LostFocus="SearchBox_LostFocus"/>

                    <Path Grid.Column="1"
                          Data="{StaticResource SearchIcon}"
                          Fill="{StaticResource TextSecondaryColor}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Дата -->
            <TextBlock Grid.Column="2"
                       Text="October"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryColor}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- Сетка событий или пустое состояние -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- Пустое состояние -->
                <StackPanel x:Name="EmptyStatePanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource PrimaryFont}"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryColor}"
                               HorizontalAlignment="Center">
                        <Run Text="К сожалению, вы ещё не добавили мероприятия. "/>
                        <Hyperlink Click="GoToAffiche_Click"
                                   TextDecorations="None">
                            <Run Text="Перейти в афишу"
                                 Foreground="{StaticResource TextPrimaryColor}"
                                 FontWeight="SemiBold"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- Сетка событий -->
                <WrapPanel x:Name="EventsPanel"
                           Orientation="Horizontal">
                    <!-- События будут добавлены программно -->
                </WrapPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
