<Page x:Class="Kursachzhoska.Pages.EditEventPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursachzhoska.Pages"
      xmlns:controls="clr-namespace:Kursachzhoska.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1140"
      Background="{StaticResource BackgroundColor}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" ClipToBounds="False">
        <Grid Margin="48,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,32">
                <TextBlock Text="Редактирование мероприятия"
                           Style="{StaticResource H1}"/>
            </StackPanel>

            <!-- Форма -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    MaxWidth="800"
                    HorizontalAlignment="Left"
                    Padding="32">
                <StackPanel>
                    <!-- Title and Location -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Название"
                                       Style="{StaticResource H3}"
                                       Margin="0,0,0,8"/>
                            <controls:TextBoxWithPlaceholder x:Name="TitleTextBox"
                                                           Placeholder="Название мероприятия"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Место"
                                       Style="{StaticResource H3}"
                                       Margin="0,0,0,8"/>
                            <controls:TextBoxWithPlaceholder x:Name="LocationTextBox"
                                                           Placeholder="Место проведения"/>
                        </StackPanel>
                    </Grid>

                    <!-- Description and Date -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Описание"
                                       Style="{StaticResource H3}"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="DescriptionTextBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Tag="Введите описание"
                                     Height="100"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Дата и время"
                                       Style="{StaticResource H3}"
                                       Margin="0,0,0,8"/>
                            <DatePicker x:Name="EventDatePicker"
                                       Style="{StaticResource ModernDatePicker}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Price -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Цена (₽)"
                                   Style="{StaticResource H3}"
                                   Margin="0,0,0,8"/>
                        <controls:TextBoxWithPlaceholder x:Name="PriceTextBox"
                                                       Placeholder="Цена (0 = бесплатно)"
                                                       MaxWidth="200"
                                                       HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Categories -->
                    <TextBlock Text="Категория"
                               Style="{StaticResource H3}"
                               Margin="0,0,0,8"/>
                    <WrapPanel x:Name="CategoriesPanel"
                               Margin="0,0,0,24"/>

                    <!-- Contractors -->
                    <TextBlock Text="Добавить подрядчика"
                               Style="{StaticResource H3}"
                               Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <controls:TextBoxWithPlaceholder Grid.Column="0"
                                                       x:Name="ContractorNameTextBox"
                                                       Placeholder="Имя подрядчика"/>
                        
                        <controls:TextBoxWithPlaceholder Grid.Column="2"
                                                       x:Name="ContractorRoleTextBox"
                                                       Placeholder="Роль"/>
                        
                        <Button Grid.Column="4"
                                Content="Добавить"
                                Style="{StaticResource DarkButton}"
                                Padding="24,12"
                                Click="AddContractorButton_Click"/>
                    </Grid>
                    
                    <StackPanel x:Name="ContractorsPanel"
                                Margin="0,0,0,24">
                        <!-- Подрядчики будут добавлены программно -->
                    </StackPanel>

                    <!-- Изображение -->
                    <TextBlock Text="Добавить изображение"
                               Style="{StaticResource H3}"
                               Margin="0,0,0,16"/>
                    
                    <!-- Превью изображения -->
                    <Grid Width="200" Height="200" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <Border x:Name="EventImagePreview"
                                Width="200"
                                Height="200"
                                Background="#F3F4F6"
                                CornerRadius="8">
                            <Grid>
                                <Image x:Name="EventImage"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed"/>
                                <!-- Плейсхолдер для пустого состояния -->
                                <Path x:Name="EventImagePlaceholder"
                                      Data="{StaticResource CameraIcon}"
                                      Fill="{StaticResource TextSecondaryColor}"
                                      Width="48"
                                      Height="48"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- Кнопка плюсика -->
                        <Button x:Name="AddEventPhotoIconButton"
                                Content="+"
                                Width="32"
                                Height="32"
                                Background="{StaticResource AccentColor}"
                                Foreground="White"
                                BorderThickness="2"
                                BorderBrush="White"
                                FontSize="18"
                                FontWeight="Bold"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,8,8"
                                Cursor="Hand"
                                Click="UploadEventPhotoButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="16">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Button x:Name="UploadEventPhotoButton"
                            Content="⬆ Загрузить фото"
                            Style="{StaticResource LightButton}"
                            HorizontalAlignment="Left"
                            Padding="16,10"
                            Margin="0,0,0,24"
                            Click="UploadEventPhotoButton_Click"/>

                    <!-- Documents -->
                    <TextBlock Text="Добавить документы"
                               Style="{StaticResource H3}"
                               Margin="0,0,0,8"/>
                    <Button x:Name="UploadDocumentButton"
                            Content="⬆ Загрузить документ"
                            Style="{StaticResource LightButton}"
                            HorizontalAlignment="Left"
                            Padding="16,10"
                            Margin="0,0,0,16"
                            Click="UploadDocumentButton_Click"/>
                    
                    <StackPanel x:Name="DocumentsPanel"
                                Margin="0,0,0,24">
                        <!-- Документы будут добавлены программно -->
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Отмена"
                                Style="{StaticResource LightButton}"
                                Padding="24,12"
                                Margin="0,0,12,0"
                                Click="CancelButton_Click"/>
                        <Button x:Name="SaveEventButton"
                                Content="Сохранить"
                                Style="{StaticResource DarkButton}"
                                Padding="24,12"
                                Click="SaveEventButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

