<Page x:Class="Kursachzhoska.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursachzhoska.Pages"
      xmlns:controls="clr-namespace:Kursachzhoska.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1400"
      Background="{StaticResource BackgroundColor}">

    <Grid>
        <!-- Центральная карточка регистрации -->
        <Border Style="{StaticResource Card}"
                MaxWidth="500"
                MinWidth="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource CardBackground}">
            <StackPanel Margin="40" ClipToBounds="False">
                <!-- Индикатор прогресса -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border x:Name="Step1Indicator" Grid.Column="0" Height="3" Background="{StaticResource AccentColor}" CornerRadius="2"/>
                    <Border x:Name="Step2Indicator" Grid.Column="2" Height="3" Background="{StaticResource BorderColor}" CornerRadius="2"/>
                    <Border x:Name="Step3Indicator" Grid.Column="4" Height="3" Background="{StaticResource BorderColor}" CornerRadius="2"/>
                </Grid>
                
                <!-- Заголовок -->
                <TextBlock Text="Создать аккаунт"
                           Style="{StaticResource H2}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                
                <!-- Подзаголовок -->
                <TextBlock x:Name="StepDescription"
                           Text="Шаг 1 из 3: Личные данные"
                           FontFamily="{StaticResource PrimaryFont}"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryColor}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>
                
                <!-- Контейнер для шагов -->
                <Grid x:Name="ContentGrid" ClipToBounds="False">
                    <!-- Шаг 1: Personal Info -->
                    <StackPanel x:Name="Step1Panel" Visibility="Visible">
                        <controls:TextBoxWithPlaceholder x:Name="NameTextBox"
                                                         Placeholder="Имя"
                                                         Margin="0,0,0,12"/>
                        
                        <controls:TextBoxWithPlaceholder x:Name="SurnameTextBox"
                                                         Placeholder="Фамилия"
                                                         Margin="0,0,0,12"/>
                        
                        <DatePicker x:Name="DateOfBirthPicker"
                                    Style="{StaticResource ModernDatePicker}"
                                    Margin="0,0,0,12"/>
                        
                        <CheckBox x:Name="ConsentCheckBox"
                                  Margin="0,0,0,24"
                                  VerticalContentAlignment="Center">
                            <TextBlock Text="Я согласен(а) на обработку персональных данных"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       TextWrapping="Wrap"/>
                        </CheckBox>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource LightButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="BackToLogin_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource ArrowBackIcon}" Fill="{StaticResource TextPrimaryColor}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Назад" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Content="Далее"
                                    Style="{StaticResource DarkButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="Step1Continue_Click"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Шаг 2: Location Info -->
                    <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                        <controls:TextBoxWithPlaceholder x:Name="EmailTextBox"
                                                         Placeholder="Электронная почта"
                                                         Margin="0,0,0,12"/>
                        
                        <controls:PasswordBoxWithPlaceholder x:Name="RegPasswordBox"
                                                             Placeholder="Пароль"
                                                             Margin="0,0,0,12"/>
                        
                        <controls:TextBoxWithPlaceholder x:Name="PhoneTextBox"
                                                         Placeholder="Номер телефона"
                                                         Margin="0,0,0,24"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource LightButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="Step2Back_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource ArrowBackIcon}" Fill="{StaticResource TextPrimaryColor}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Назад" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Content="Далее"
                                    Style="{StaticResource DarkButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="Step2Continue_Click"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Шаг 3: Preferences -->
                    <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                        <WrapPanel x:Name="CategoriesPanel" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,24">
                            <!-- Категории будут добавлены программно -->
                        </WrapPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource LightButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="Step3Back_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource ArrowBackIcon}" Fill="{StaticResource TextPrimaryColor}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Назад" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Content="Зарегистрироваться"
                                    Style="{StaticResource DarkButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="SignUpButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
