<Page x:Class="Kursachzhoska.Pages.BonusHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="BonusHistoryPage" Background="White">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="История бонусов" FontSize="24" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,8"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Текущий баланс: " FontSize="14" Foreground="#8B8B8B" VerticalAlignment="Center"/>
                <TextBlock x:Name="BonusBalanceText" Text="0" FontSize="14" FontWeight="Bold" Foreground="#4338CA" VerticalAlignment="Center"/>
                <TextBlock Text=" баллов" FontSize="14" Foreground="#8B8B8B" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="500">
                <StackPanel x:Name="TransactionsPanel"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
