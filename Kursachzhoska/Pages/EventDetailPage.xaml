<Page x:Class="Kursachzhoska.Pages.EventDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursachzhoska.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="{StaticResource BackgroundColor}">

    <Grid>
        <!-- Навигационная панель -->
        <Border Height="70" 
                VerticalAlignment="Top"
                Background="{StaticResource SurfaceColor}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource BorderColor}">
            <Grid Margin="40,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}"
                           Padding="15,8"
                           Click="BackButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ArrowBackIcon}" Fill="{StaticResource TextPrimaryColor}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Назад" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button Content="Главная" 
                           Style="{StaticResource SecondaryButton}"
                           Margin="0,0,15,0"
                           Padding="15,8"
                           Click="HomeButton_Click"/>
                    <Button Content="Профиль" 
                           Style="{StaticResource PrimaryButton}"
                           Padding="15,8"
                           Click="ProfileButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <ScrollViewer Margin="0,70,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="80,40">
                <!-- Изображение мероприятия -->
                <Border Height="400"
                       Background="#E0E7FF"
                       CornerRadius="20"
                       Margin="0,0,0,40">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource CameraIcon}" Fill="{StaticResource PrimaryColor}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="ФОТО МЕРОПРИЯТИЯ" 
                                  FontSize="24"
                                  HorizontalAlignment="Center"
                                  Foreground="{StaticResource PrimaryColor}"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка - основная информация -->
                    <StackPanel Grid.Column="0">
                        <!-- Категория и рейтинг -->
                        <Grid Margin="0,0,0,20">
                            <Border Background="{StaticResource PrimaryColor}"
                                   CornerRadius="6"
                                   Padding="12,6"
                                   HorizontalAlignment="Left">
                                <TextBlock Text="IT" 
                                          Foreground="White"
                                          FontSize="14"
                                          FontWeight="SemiBold"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" 
                                       HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                    <Path Data="{StaticResource StarIcon}" Fill="#FCD34D" Width="16" Height="16" Stretch="Uniform" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource StarIcon}" Fill="#FCD34D" Width="16" Height="16" Stretch="Uniform" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource StarIcon}" Fill="#FCD34D" Width="16" Height="16" Stretch="Uniform" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource StarIcon}" Fill="#FCD34D" Width="16" Height="16" Stretch="Uniform" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource StarIcon}" Fill="#FCD34D" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="4.8" 
                                          FontSize="20"
                                          FontWeight="Bold"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Название -->
                        <TextBlock Text="IT-конференция 2024" 
                                  Style="{StaticResource H1}"
                                  Margin="0,0,0,20"/>

                        <!-- Детали -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource CalendarIcon}" 
                                          Fill="{StaticResource TextPrimaryColor}"
                                          Width="20" 
                                          Height="20"
                                          Stretch="Uniform"
                                          Margin="0,0,15,0"
                                          VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Дата и время" 
                                                  FontSize="12"
                                                  Foreground="{StaticResource TextSecondaryColor}"/>
                                        <TextBlock Text="15 ноября 2024, 10:00" 
                                                  FontSize="16"
                                                  FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Path Data="{StaticResource LocationIcon}" 
                                          Fill="{StaticResource TextPrimaryColor}"
                                          Width="20" 
                                          Height="20"
                                          Stretch="Uniform"
                                          Margin="0,0,15,0"
                                          VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Место проведения" 
                                                  FontSize="12"
                                                  Foreground="{StaticResource TextSecondaryColor}"/>
                                        <TextBlock Text="Конгресс-центр, Москва" 
                                                  FontSize="16"
                                                  FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource TicketIcon}" 
                                          Fill="{StaticResource TextPrimaryColor}"
                                          Width="20" 
                                          Height="20"
                                          Stretch="Uniform"
                                          Margin="0,0,15,0"
                                          VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Стоимость" 
                                                  FontSize="12"
                                                  Foreground="{StaticResource TextSecondaryColor}"/>
                                        <TextBlock FontSize="20"
                                                  FontWeight="Bold"
                                                  Foreground="{StaticResource PrimaryColor}">
                                            <Run Text="2,500"/>
                                            <Run Text="₽"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Описание -->
                        <TextBlock Text="О мероприятии" 
                                  Style="{StaticResource H2}"
                                  Margin="0,0,0,15"/>
                        <TextBlock Text="Присоединяйтесь к главной IT-конференции года! Мы собрали лучших экспертов индустрии, которые поделятся своим опытом и знаниями. Узнайте о последних трендах в разработке, облачных технологиях, искусственном интеллекте и многом другом. Нетворкинг с профессионалами, вдохновляющие доклады и практические мастер-классы ждут вас!"
                                  FontSize="16"
                                  Foreground="{StaticResource TextSecondaryColor}"
                                  TextWrapping="Wrap"
                                  LineHeight="24"
                                  Margin="0,0,0,30"/>

                        <!-- Подрядчики -->
                        <TextBlock Text="Подрядчики" 
                                  Style="{StaticResource H2}"
                                  Margin="0,0,0,15"/>
                        <StackPanel Margin="0,0,0,40">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="50" Height="50"
                                           Background="{StaticResource PrimaryColor}"
                                           CornerRadius="25"
                                           Margin="0,0,15,0">
                                        <TextBlock Text="МГ" 
                                                  Foreground="White"
                                                  FontSize="18"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Михаил Гринчук" 
                                                  FontSize="16"
                                                  FontWeight="SemiBold"/>
                                        <TextBlock Text="Фотограф" 
                                                  FontSize="14"
                                                  Foreground="{StaticResource TextSecondaryColor}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Отзывы -->
                        <TextBlock Text="Отзывы" 
                                  Style="{StaticResource H2}"
                                  Margin="0,0,0,15"/>
                        
                        <!-- Пример отзыва -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40"
                                               Background="{StaticResource AccentColor}"
                                               CornerRadius="20"
                                               Margin="0,0,10,0">
                                            <TextBlock Text="ИП" 
                                                      Foreground="White"
                                                      FontSize="14"
                                                      FontWeight="Bold"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Иван Петров" 
                                                      FontSize="14"
                                                      FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource StarIcon}" Fill="#FCD34D" Width="12" Height="12" Stretch="Uniform" Margin="0,0,2,0"/>
                                                <Path Data="{StaticResource StarIcon}" Fill="#FCD34D" Width="12" Height="12" Stretch="Uniform" Margin="0,0,2,0"/>
                                                <Path Data="{StaticResource StarIcon}" Fill="#FCD34D" Width="12" Height="12" Stretch="Uniform" Margin="0,0,2,0"/>
                                                <Path Data="{StaticResource StarIcon}" Fill="#FCD34D" Width="12" Height="12" Stretch="Uniform" Margin="0,0,2,0"/>
                                                <Path Data="{StaticResource StarIcon}" Fill="#FCD34D" Width="12" Height="12" Stretch="Uniform"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="2 дня назад" 
                                              FontSize="12"
                                              Foreground="{StaticResource TextSecondaryColor}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="Отличная конференция!" 
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,5"/>
                                <TextBlock Text="Очень понравилась организация мероприятия. Интересные доклады, полезные контакты. Обязательно приду в следующем году!"
                                          FontSize="14"
                                          Foreground="{StaticResource TextSecondaryColor}"
                                          TextWrapping="Wrap"
                                          LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Правая колонка - действия -->
                    <Border Grid.Column="2" 
                           Style="{StaticResource Card}"
                           VerticalAlignment="Top"
                           Padding="25">
                        <StackPanel>
                            <TextBlock Text="Регистрация" 
                                      Style="{StaticResource H3}"
                                      Margin="0,0,0,20"/>

                            <Button Content="Зарегистрироваться"
                                   Style="{StaticResource PrimaryButton}"
                                   Height="50"
                                   Margin="0,0,0,15"
                                   Click="RegisterButton_Click"/>

                            <Button Style="{StaticResource SecondaryButton}"
                                   Height="50"
                                   Padding="10"
                                   Click="AddToFavoritesButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource FavoriteIcon}" Fill="#EF4444" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Добавить в понравившиеся" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>

                            <Separator Margin="0,25,0,25"/>

                            <TextBlock Text="Организатор" 
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="Компания мероприятий" 
                                      FontSize="14"
                                      Foreground="{StaticResource TextSecondaryColor}"
                                      TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

