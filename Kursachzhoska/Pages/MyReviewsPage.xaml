<Page x:Class="Kursachzhoska.Pages.MyReviewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursachzhoska.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="{StaticResource BackgroundColor}">

    <Grid>
        <!-- Основной контент -->
        <ScrollViewer Margin="0,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30">
                <TextBlock x:Name="PageTitle"
                          Text="Отзывы" 
                          Style="{StaticResource H1}"
                          Margin="0,0,0,20"/>
                
                <!-- Переключатель для организатора -->
                <StackPanel x:Name="OrganizerTogglePanel"
                          Orientation="Horizontal"
                          Margin="0,0,0,20"
                          Visibility="Collapsed">
                    <Button x:Name="ReviewsAboutMeButton"
                          Content="Отзывы обо мне"
                          Style="{StaticResource DarkButton}"
                          Padding="20,10"
                          FontSize="13"
                          Click="ReviewsAboutMeButton_Click"
                          Margin="0,0,12,0"/>
                    <Button x:Name="MyReviewsButton"
                          Content="Мои отзывы"
                          Style="{StaticResource LightButton}"
                          Padding="20,10"
                          FontSize="13"
                          Click="MyReviewsButton_Click"/>
                </StackPanel>

                <!-- Пустое состояние -->
                <StackPanel x:Name="EmptyStatePanel" 
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,100">
                    <Path Data="{StaticResource ReviewIcon}"
                          Fill="{StaticResource TextSecondaryColor}"
                          Width="80"
                          Height="80"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20"/>
                    <TextBlock Text="Отзывов пока нет" 
                              Style="{StaticResource H2}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10"/>
                    <TextBlock Text="Когда пользователи оставят отзывы на ваши мероприятия, они появятся здесь" 
                              FontSize="14"
                              Foreground="{StaticResource TextSecondaryColor}"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              MaxWidth="400"
                              TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Список отзывов -->
                <StackPanel x:Name="ReviewsPanel">
                    <!-- Отзывы будут добавлены программно -->
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

