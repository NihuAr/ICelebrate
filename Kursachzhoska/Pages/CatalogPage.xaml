<Page x:Class="Kursachzhoska.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursachzhoska.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1140"
      Background="{StaticResource BackgroundColor}">

    <Grid Margin="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

                    <!-- Заголовок и поиск -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Афиша"
                       Style="{StaticResource H1}"
                       VerticalAlignment="Center"
                       Margin="0,0,32,0"/>

            <!-- Поиск -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    MaxWidth="400"
                    HorizontalAlignment="Left">
                                    <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                    <!-- Placeholder -->
                    <TextBlock Grid.Column="0"
                               x:Name="SearchPlaceholder"
                               Text="Найти..."
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryColor}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <TextBox Grid.Column="0"
                             x:Name="SearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             FontFamily="{StaticResource PrimaryFont}"
                             FontSize="14"
                             Foreground="{StaticResource TextPrimaryColor}"
                             TextChanged="SearchBox_TextChanged"
                             GotFocus="SearchBox_GotFocus"
                             LostFocus="SearchBox_LostFocus"/>

                    <Path Grid.Column="1"
                          Data="{StaticResource SearchIcon}"
                          Fill="{StaticResource TextSecondaryColor}"
                          Width="16"
                          Height="16"
                          Stretch="Uniform"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

            <!-- Дата и фильтр -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock x:Name="CurrentMonthText"
                           Text="November"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryColor}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <Button x:Name="FilterButton"
                        Style="{StaticResource LightButton}"
                        Padding="12,8"
                        FontSize="13"
                        Click="FilterButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FilterIcon}" Fill="{StaticResource TextPrimaryColor}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Фильтр" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                </StackPanel>
        </Grid>
        
        <!-- Панель фильтров (скрытая по умолчанию) -->
        <Border x:Name="FilterPanel"
                Grid.Row="1"
                Background="{StaticResource SurfaceColor}"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Фильтры"
                           Style="{StaticResource H3}"
                           Margin="0,0,0,16"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Фильтр по дате от -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Дата от"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   Margin="0,0,0,8"/>
                        
                        <DatePicker x:Name="FromDatePicker"
                                    Style="{StaticResource ModernDatePicker}"
                                    SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                    </StackPanel>
                    
                    <!-- Фильтр по дате до -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Дата до"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   Margin="0,0,0,8"/>
                        
                        <DatePicker x:Name="ToDatePicker"
                                    Style="{StaticResource ModernDatePicker}"
                                    SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                    </StackPanel>
                </Grid>
                
                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Content="Сбросить"
                            Style="{StaticResource LightButton}"
                            Padding="16,8"
                            Margin="0,0,12,0"
                            Click="ResetFiltersButton_Click"/>
                    <Button Content="Применить"
                            Style="{StaticResource DarkButton}"
                            Padding="16,8"
                            Click="ApplyFiltersButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Категории (горизонтальная прокрутка) -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="0,0,0,24">
            <StackPanel x:Name="CategoriesPanel"
                        Orientation="Horizontal">
                <!-- Категории будут добавлены программно -->
            </StackPanel>
        </ScrollViewer>

        <!-- Сетка событий -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="EventsPanel"
                       Orientation="Horizontal">
                <!-- События будут добавлены программно -->
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Page>
