<Page x:Class="Kursachzhoska.Pages.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursachzhoska.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1400"
      Background="{StaticResource BackgroundColor}">

    <Grid>
        <!-- Центральная карточка приветствия -->
        <Border Style="{StaticResource Card}"
                MaxWidth="500"
                MinWidth="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource CardBackground}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="40">
                <!-- Заголовок -->
                <TextBlock Text="Привет!"
                           Style="{StaticResource H1}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                
                <!-- Подзаголовок -->
                <TextBlock Text="Войдите, чтобы начать работу"
                           FontFamily="{StaticResource PrimaryFont}"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryColor}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,32"/>
                
                <!-- Кнопка Start -->
                <Button Content="Начать"
                        Style="{StaticResource DarkButton}"
                        MinWidth="200"
                        Click="StartButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
