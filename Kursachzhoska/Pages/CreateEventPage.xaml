<Page x:Class="Kursachzhoska.Pages.CreateEventPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kursachzhoska.Pages"
      xmlns:controls="clr-namespace:Kursachzhoska.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="1140"
      Background="{StaticResource BackgroundColor}">

    <Grid Margin="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="Новое мероприятие"
                       Style="{StaticResource H1}"
                       VerticalAlignment="Center"/>

            <TextBlock Text="October"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryColor}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
            </Grid>

        <!-- Форма создания события -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" ClipToBounds="False">
            <Border Style="{StaticResource Card}"
                   MaxWidth="900"
                    HorizontalAlignment="Left"
                    Padding="32">
                <StackPanel>
                    <!-- Main info -->
                    <TextBlock Text="Основная информация"
                               Style="{StaticResource H3}"
                               Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Название -->
                        <controls:TextBoxWithPlaceholder Grid.Row="0" Grid.Column="0"
                                                         x:Name="TitleTextBox"
                                                         Placeholder="Название"
                                                         Margin="0,0,0,16"/>

                        <!-- Место -->
                        <controls:TextBoxWithPlaceholder Grid.Row="0" Grid.Column="2"
                                                         x:Name="LocationTextBox"
                                                         Placeholder="Место проведения"
                                                         Margin="0,0,0,16"/>

                        <!-- Описание -->
                        <controls:TextBoxWithPlaceholder Grid.Row="1" Grid.Column="0"
                                                         x:Name="DescriptionTextBox"
                                                         Placeholder="Описание"
                                                         Margin="0,0,0,0"/>

                        <!-- Дата -->
                        <DatePicker Grid.Row="1" Grid.Column="2"
                                    x:Name="EventDatePicker"
                                    Style="{StaticResource ModernDatePicker}"
                                    Margin="0,0,0,0"/>
                    </Grid>

                    <!-- Категории -->
                    <TextBlock Text="Выберите категории"
                               Style="{StaticResource H3}"
                               Margin="0,0,0,16"/>

                    <WrapPanel x:Name="CategoriesPanel" Margin="0,0,0,24">
                        <!-- Категории будут добавлены программно -->
                    </WrapPanel>

                    <!-- Подрядчики -->
                    <TextBlock Text="Подрядчики"
                               Style="{StaticResource H3}"
                               Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <controls:TextBoxWithPlaceholder Grid.Column="0"
                                                         x:Name="ContractorNameTextBox"
                                                         Placeholder="Имя подрядчика"/>

                        <controls:TextBoxWithPlaceholder Grid.Column="2"
                                                         x:Name="ContractorRoleTextBox"
                                                         Placeholder="Роль/Профессия"/>
                    </Grid>

                    <Button x:Name="UploadDocumentButton"
                            Content="📎 Загрузить документ"
                            Style="{StaticResource LightButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16"
                            Padding="16,10"
                            Click="UploadDocumentButton_Click"/>
                    
                    <!-- Список документов -->
                    <StackPanel x:Name="DocumentsPanel"
                                Margin="0,0,0,16">
                        <!-- Документы будут добавлены программно -->
                    </StackPanel>

                    <Button x:Name="AddContractorButton"
                            Content="Добавить подрядчика +"
                            Style="{StaticResource IconButton}"
                            Foreground="{StaticResource TextPrimaryColor}"
                            HorizontalAlignment="Left"
                            FontSize="13"
                            Padding="0,4"
                            Margin="0,0,0,8"
                            Click="AddContractorButton_Click"/>
                    
                    <!-- Список подрядчиков -->
                    <StackPanel x:Name="ContractorsPanel"
                                Margin="0,0,0,24">
                        <!-- Подрядчики будут добавлены программно -->
                    </StackPanel>

                    <!-- Изображение -->
                    <TextBlock Text="Добавить изображение"
                               Style="{StaticResource H3}"
                               Margin="0,0,0,16"/>
                    
                    <!-- Превью изображения -->
                    <Grid Width="200" Height="200" HorizontalAlignment="Left" Margin="0,0,0,16">
                        <Border x:Name="EventImagePreview"
                                Width="200"
                                Height="200"
                                Background="#F3F4F6"
                                CornerRadius="8">
                            <Grid>
                                <Image x:Name="EventImage"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed"/>
                                <!-- Плейсхолдер для пустого состояния -->
                                <Path x:Name="EventImagePlaceholder"
                                      Data="{StaticResource CameraIcon}"
                                      Fill="{StaticResource TextSecondaryColor}"
                                      Width="48"
                                      Height="48"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- Кнопка плюсика -->
                        <Button x:Name="AddEventPhotoIconButton"
                                Content="+"
                                Width="32"
                                Height="32"
                                Background="{StaticResource AccentColor}"
                                Foreground="White"
                                BorderThickness="2"
                                BorderBrush="White"
                                FontSize="18"
                                FontWeight="Bold"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,8,8"
                                Cursor="Hand"
                                Click="UploadEventPhotoButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="16">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Button x:Name="UploadEventPhotoButton"
                            Content="⬆ Загрузить фото"
                            Style="{StaticResource LightButton}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Padding="16,10"
                            Click="UploadEventPhotoButton_Click"/>

                    <TextBlock Text="Рекомендуемый размер 800*800px."
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryColor}"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="Допускаются JPG или PNG"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryColor}"
                               Margin="0,0,0,32"/>

                    <!-- Кнопки действий -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Сохранить"
                                Style="{StaticResource DarkButton}"
                                Margin="0,0,12,0"
                                Click="SaveEventButton_Click"/>

                        <Button Content="Отмена"
                                Style="{StaticResource LightButton}"
                                Click="CancelButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
